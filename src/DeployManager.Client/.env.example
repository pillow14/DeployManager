# URL base de la API de DeployManager.
# En produccion la SPA es servida por la propia API, asi que debe quedar como '/api'.
# En desarrollo apunta a la API, p. ej. https://localhost:7268/api
VITE_API_URL=/api

# 'true' para usar paquetes de prueba (feature flag). Por defecto false.
VITE_USE_MOCK_PACKAGES=false
