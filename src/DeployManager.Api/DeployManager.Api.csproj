<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\DeployManager.Application\DeployManager.Application.csproj" />
    <ProjectReference Include="..\DeployManager.Infrastructure\DeployManager.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.1.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="wwwroot\**" />
    <Content Remove="wwwroot\**" />
    <None Include="wwwroot\**" />
  </ItemGroup>

  <Target Name="CopySpaDistToPublish" AfterTargets="ComputeFilesToPublish" Condition="Exists('..\DeployManager.Client\dist')">
    <ItemGroup>
      <SpaFiles Include="..\DeployManager.Client\dist\**" />
    </ItemGroup>
    <Copy SourceFiles="@(SpaFiles)" DestinationFiles="$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)" SkipUnchangedFiles="true" />
  </Target>

</Project>
